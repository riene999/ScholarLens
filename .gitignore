# Python environments
.venv/
venv/
env/

# Python bytecode and tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Local secrets and environment overrides
.env
.env.*
!.env.example

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
*.bak
*.swp

# Runtime uploads and local paper corpus
academic-rag/data/uploads/
academic-rag/data/papers/

# Generated vector indexes, document stores, and metadata
academic-rag/data/faiss_index*/
academic-rag/data/faiss_indexes/
academic-rag/data/*.pkl
academic-rag/data/*.sqlite
academic-rag/data/*.sqlite3

# Keep evaluation code and datasets. Ignore exploratory reports by default,
# while retaining the three reproducible baseline reports.
academic-rag/eval/results/*
!academic-rag/eval/results/results_global_top5.json
!academic-rag/eval/results/results_global_no_decomposition_top5.json
!academic-rag/eval/results/results_expanded_no_decomposition_top5.json
!academic-rag/eval/results/source_routing_eval_50.json
!academic-rag/eval/results/resume_before_global_top5.json
!academic-rag/eval/results/resume_after_expanded_top5.json
!academic-rag/eval/results/resume_after_adaptive_top5.json
!academic-rag/eval/results/resume_before_legacy_source_routing.json
!academic-rag/eval/results/resume_after_source_routing.json
academic-rag/data/cache_benchmarks/

# Local MCP client configuration
academic-rag/claude_desktop_config.json

# Keep the runtime data directory in fresh clones
!academic-rag/data/.gitkeep
